# BilPark yerel demo ortam değişkenleri (şablon).
# Bu dosyayı .env.demo adıyla kopyalayıp değerleri doldurun. .env.demo git'e girmez.
# Otomatik doldurmak için: powershell -ExecutionPolicy Bypass -File demo/yeni-env.ps1
#
# Güvenli JWT_SECRET üretmek için (en az 32 karakter gerekir):
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Git Bash:   openssl rand -base64 48
#
# DB_URL burada gerekmez: docker-compose.yml backend'i her zaman compose içindeki veritabanına bağlar.

DB_USERNAME=bilpark
DB_PASSWORD=degistir-beni
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-deger-yazin
# Yalnızca veritabanı boşken (ilk açılışta) admin ve tevfik kullanıcılarını oluşturmak için kullanılır.
ADMIN_PASSWORD=degistir-beni
OFFICER_PASSWORD=degistir-beni
# Geliştirici (bakım) hesabı: ayarlıysa açılışta bir kez 'gelistirici' kullanıcısı oluşur. Lisans uzatma ve sistem sağlığı için.
# Boş bırakılırsa geliştirici hesabı oluşmaz. Ayrıntı: docs/sozlesme-eki-gelistirici-ve-lisans.md
DEVELOPER_PASSWORD=degistir-beni
