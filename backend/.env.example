# BilPark Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Neon.tech PostgreSQL Connection
DB_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT signing secret (min 32 bytes). Generate with: openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48

# Initial seed user passwords (only used on first start, when no users exist)
ADMIN_PASSWORD=change_me_admin_password
OFFICER_PASSWORD=change_me_officer_password
